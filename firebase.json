{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/anime-like/jujutsu-kaisen-season-3/",
        "destination": "/anime-like/jujutsu-kaisen/",
        "type": 301
      },
      {
        "source": "/watch-order/100166-my-hero-academia-season-3/",
        "destination": "/watch-order/21459-my-hero-academia/",
        "type": 301
      },
      {
        "source": "/watch-order/161645-the-apothecary-diaries/",
        "destination": "/watch-order/",
        "type": 301
      },
      {
        "source": "/next-episode/mononoke/",
        "destination": "/next-episode/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|json|webp|png|jpg|jpeg|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(html|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=600"
          }
        ]
      }
    ]
  }
}
