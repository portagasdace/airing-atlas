---
interface Props {
  enabled?: boolean;
  label?: string;
}

const { enabled = true, label = "Advertisement" } = Astro.props;
const adsenseClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const adsenseSlotId = import.meta.env.PUBLIC_ADSENSE_SLOT_ID;
const shouldRenderAd = Boolean(enabled && adsenseClientId && adsenseSlotId);
---

{
  shouldRenderAd ? (
    <aside class="ad-slot" aria-label={label} data-ad-slot="manual-content">
      <span class="ad-slot-label">{label}</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={adsenseClientId}
        data-ad-slot={adsenseSlotId}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>
        (() => {
          const currentScript = document.currentScript;
          const container = currentScript?.closest("[data-ad-slot]");
          const slot = container?.querySelector(".adsbygoogle");
          if (!(slot instanceof HTMLElement)) return;

          let frames = 0;
          const requestAd = () => {
            if (slot.dataset.adRequested === "true") return;
            if (slot.getBoundingClientRect().width < 1) {
              frames += 1;
              if (frames < 120) window.requestAnimationFrame(requestAd);
              return;
            }

            slot.dataset.adRequested = "true";
            try {
              window.adsbygoogle = window.adsbygoogle || [];
              window.adsbygoogle.push({});
            } catch {
              /* Ad blockers or preview environments can reject the ad request. */
            }
          };

          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => window.requestAnimationFrame(requestAd), { once: true });
          } else {
            window.requestAnimationFrame(requestAd);
          }
        })();
      </script>
    </aside>
  ) : (
    <template data-ad-slot-disabled></template>
  )
}
