---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AffiliatePanel from "@/components/AffiliatePanel.astro";
import AdSlot from "@/components/AdSlot.astro";
import { animeSeoDescription, animeSeoTitle, canonicalPath, cleanText, dateTimeLabel, displayTitle, episodeLabel, formatNumber, genreIndex, recommendationsFor, scoreLabel, seasonLabel, titleCase, watchOrderIndex } from "@/lib/anime";
import { dedupeExternalLinks } from "@/lib/external-links";
import { manualEditorialFor, qualityWatchOrderFor } from "@/lib/manual-content";
import { isQualityNextEpisodeAnime, publicWatchOrderGuides } from "@/lib/quality";
import { animeLikeGuideHref, nextEpisodeSlug, relatedSearchIntents } from "@/lib/search-intents";
import { animeJsonLd, breadcrumbJsonLd } from "@/lib/seo";
import type { AnimeSummary } from "@/types/anime";

export function getStaticPaths() {
  return [];
}

const { anime } = Astro.props as { anime: AnimeSummary };
const title = displayTitle(anime);
const seoTitle = animeSeoTitle(anime);
const cover = anime.coverImage?.extraLarge || anime.coverImage?.large || "/og-default.svg";
const manualEditorial = manualEditorialFor(anime.id);
const formatLabel = titleCase(anime.format || "Anime");
const metaDescription = animeSeoDescription(anime, manualEditorial?.intro);
const recommendations = recommendationsFor(anime.id).slice(0, 4);
const guide = qualityWatchOrderFor(anime.id);
const publicGuideSlugs = new Set(publicWatchOrderGuides(watchOrderIndex.items).map((item) => item.slug));
const publicGuide = guide && publicGuideSlugs.has(guide.slug) ? guide : undefined;
const tags = (anime.tags || []).slice(0, 8);
const officialLinks = dedupeExternalLinks(anime.externalLinks, 5);
const studio = anime.studios?.[0]?.name;
const genreLinks = (anime.genres || []).map((genre) => ({
  name: genre,
  slug: genreIndex.items.find((item) => item.genre === genre)?.slug
}));
const searchIntents = relatedSearchIntents({ anime, recommendations, guide: publicGuide, genreLinks });
const isIndexable = false;
const primaryGenres = (anime.genres || []).slice(0, 3);
const editorialCards = manualEditorial
  ? [
      { eyebrow: "Atlas take", heading: "Why this title matters here", body: manualEditorial.atlasTake },
      { eyebrow: "Best fit", heading: "Who should watch this", body: manualEditorial.whoShouldWatch },
      { eyebrow: "Before starting", heading: "What to know first", body: manualEditorial.beforeStarting }
    ]
  : [
      {
        eyebrow: "Atlas take",
        heading: "Why this page is useful",
        body: `${title} is kept in Airing Atlas as a ${seasonLabel(anime)} ${formatLabel.toLowerCase()} entry with practical routes into schedules, similar picks, genre browsing, and local watchlist planning.`
      },
      {
        eyebrow: "Best fit",
        heading: "Who should watch this",
        body: primaryGenres.length
          ? `Use this page if you are browsing ${primaryGenres.join(", ")} anime and want a quick read on score, popularity, status, next episode timing, and adjacent recommendations.`
          : "Use this page if you want a quick read on score, popularity, status, next episode timing, and adjacent recommendations."
      },
      {
        eyebrow: "Before starting",
        heading: "What to know first",
        body: `${anime.status ? `Status is ${titleCase(anime.status)}. ` : ""}${anime.source ? `Source type is ${titleCase(anime.source)}. ` : ""}Check the related guides before committing if you need a watch order, a shorter alternative, or a legal viewing route.`
      }
    ];
const structuredData = [
  breadcrumbJsonLd([
    { name: "Airing Atlas", path: "/" },
    { name: "Anime", path: "/discover/" },
    { name: title, path: `/anime/${anime.slug}/` }
  ]),
  animeJsonLd(anime, title, metaDescription, cover)
];
---

<BaseLayout
  title={seoTitle}
  description={metaDescription}
  canonical={canonicalPath(`/anime/${anime.slug}/`)}
  image={cover}
  robots={isIndexable ? undefined : "noindex,follow"}
  structuredData={structuredData}
  adsEnabled={isIndexable}
>
  <section class="detail-hero" data-track-section="anime_detail_hero">
    <img class="detail-poster" src={cover} alt="" width="300" height="420" referrerpolicy="no-referrer" />
    <div class="detail-copy">
      <p class="eyebrow">{seasonLabel(anime)} · {anime.format || "Anime"}</p>
      <h1>{title}</h1>
      <p class="lede">{manualEditorial?.intro || cleanText(anime.description, 260)}</p>
      <div class="hero-actions">
        <button
          class="button primary"
          type="button"
          data-watchlist-toggle
          data-anime-id={anime.id}
          data-title={title}
          data-cover={cover}
          data-slug={anime.slug}
          data-next-airing={anime.nextAiringEpisode?.airingAt || ""}
        >
          Add
        </button>
        <label>
          <span class="sr-only">Watch status</span>
          <select
            data-watchlist-status
            data-anime-id={anime.id}
            data-title={title}
            data-cover={cover}
            data-slug={anime.slug}
            data-next-airing={anime.nextAiringEpisode?.airingAt || ""}
          >
            <option value="watching">watching</option>
            <option value="planned" selected>planned</option>
            <option value="completed">completed</option>
            <option value="dropped">dropped</option>
          </select>
        </label>
        <a class="button" href={`/similar/?anime=${anime.id}`} data-track-event="detail_open_similar" data-track-label={title}>Similar</a>
        <a class="button" href={animeLikeGuideHref(anime)} data-track-event="detail_open_anime_like" data-track-label={title} data-anime-id={anime.id}>Anime like this</a>
        {isQualityNextEpisodeAnime(anime) && <a class="button" href={`/next-episode/${nextEpisodeSlug(anime)}/`} data-track-event="next_episode_detail_click" data-track-label={`${title} next episode`} data-anime-id={anime.id}>Next episode</a>}
        {publicGuide && <a class="button" href={`/watch-order/${publicGuide.slug}/`} data-track-event="detail_open_watch_order" data-track-label={publicGuide.title}>Watch order</a>}
      </div>
      <div class="fact-strip">
        <div><span>Score</span><strong>{scoreLabel(anime)}</strong></div>
        <div><span>Episodes</span><strong>{episodeLabel(anime)}</strong></div>
        <div><span>Popularity</span><strong>{formatNumber(anime.popularity)}</strong></div>
        <div><span>Next</span><strong>{dateTimeLabel(anime.nextAiringEpisode?.airingAt)}</strong></div>
      </div>
      <div class="detail-meta">
        {studio && <span>Main studio: {studio}</span>}
        {anime.source && <span>Source: {titleCase(anime.source)}</span>}
        {anime.status && <span>Status: {titleCase(anime.status)}</span>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="tag-row">
      {genreLinks.map((genre) => (
        genre.slug
          ? <a href={`/genres/${genre.slug}/`} data-track-event="detail_genre_click" data-track-label={genre.name}>{genre.name}</a>
          : <span>{genre.name}</span>
      ))}
      {tags.map((tag) => <span>{tag.name}</span>)}
    </div>
  </section>

  <section class="section guide-grid" data-track-section="anime_editorial_value">
    {editorialCards.map((card) => (
      <article class="guide-card">
        <p class="eyebrow">{card.eyebrow}</p>
        <h2>{card.heading}</h2>
        <p>{card.body}</p>
      </article>
    ))}
  </section>

  <section class="section">
    <div class="keyword-panel" data-track-section="related_guides">
      <p class="eyebrow">Related guides</p>
      <h2>Useful routes from {title}</h2>
      <p>Readable next steps for similar anime, release timing, genre discovery, and watch order research.</p>
      <div class="keyword-list">
        {searchIntents.map((item) => (
          <a href={item.href} data-track-event="related_guide_click" data-track-label={item.label} data-anime-id={anime.id}>
            <span>{item.intent}</span>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  {recommendations.length > 0 && (
    <section class="section">
      <div class="section-header">
        <div>
          <p class="eyebrow">Similar anime</p>
          <h2>Watch next if you like {title}</h2>
          <p>Recommendations combine AniList user signals with shared genre, tag, format, studio, and score patterns.</p>
        </div>
        <a class="button" href={`/similar/?anime=${anime.id}`} data-track-event="detail_open_similar_section" data-track-label={title} data-anime-id={anime.id}>Open finder</a>
      </div>
      <div class="recommendation-grid">
        {recommendations.map((item) => (
          <article class="recommendation-card">
            <a class="result-poster" href={`/anime/${item.slug}/`} data-track-event="detail_similar_click" data-track-label={item.title} data-anime-id={item.animeId}>
              <img src={item.coverImage || "/og-default.svg"} alt="" width="104" height="146" loading="lazy" referrerpolicy="no-referrer" />
            </a>
            <div>
              <p class="eyebrow">{item.source === "anilist" ? "AniList signal" : "Atlas match"}</p>
              <h3><a href={`/anime/${item.slug}/`} data-track-event="detail_similar_click" data-track-label={item.title} data-anime-id={item.animeId}>{item.title}</a></h3>
              <p>{item.reason}</p>
              <div class="tag-row">
                {(item.signals || []).slice(0, 2).map((signal) => <span>{signal}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {publicGuide && (
    <section class="section">
      <div class="editor-note">
        <p class="eyebrow">Franchise path</p>
        <h2>{publicGuide.title}</h2>
        <p>{publicGuide.description}</p>
        <a class="button small" href={`/watch-order/${publicGuide.slug}/`}>Open watch order</a>
      </div>
    </section>
  )}

  {(manualEditorial || anime.editorialNote) && (
    <section class="section">
      <div class="editor-note">
        <p class="eyebrow">Atlas editor note</p>
        <p>{manualEditorial?.intro || anime.editorialNote}</p>
        {manualEditorial?.legalWatchingNote && <p>{manualEditorial.legalWatchingNote}</p>}
      </div>
    </section>
  )}

  <section class="section">
    <AdSlot enabled={isIndexable} />
    {officialLinks.length > 0 && (
      <div class="editor-note official-links">
        <p class="eyebrow">Official links</p>
        <div class="link-list">
          {officialLinks.map((link) => (
            <a href={link.url || "#"} rel="nofollow noopener" target="_blank" data-track-event="legal_link_click" data-track-label={`${title} ${link.site}`}>{link.site}</a>
          ))}
        </div>
      </div>
    )}
    <AffiliatePanel anime={anime} />
  </section>
</BaseLayout>
