---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { allAnime, animeById, canonicalPath, displayTitle } from "@/lib/anime";
import { manualFeaturedAnimeIds, manualSimilarGuideFor } from "@/lib/manual-content";
import { adsenseReviewAnimeLikePages } from "@/lib/quality";
import { animeLikeSlug } from "@/lib/search-intents";
import { collectionPageJsonLd } from "@/lib/seo";
import type { AnimeSummary } from "@/types/anime";

const publicGuides = adsenseReviewAnimeLikePages(allAnime);
const curated = manualFeaturedAnimeIds
  .map((id) => animeById(id))
  .filter((anime): anime is AnimeSummary => Boolean(anime && publicGuides.some((item) => item.id === anime.id)));
const title = "Anime Like Guides";
const description = "Read six manually edited anime recommendation guides covering Attack on Titan, Demon Slayer, Jujutsu Kaisen, Death Note, A Silent Voice, and Psycho-Pass.";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalPath("/anime-like/")}
  structuredData={collectionPageJsonLd({
    name: title,
    description,
    path: "/anime-like/",
    items: curated
  })}
>
  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Similarity guides</p>
        <h1>Anime Like Guides</h1>
        <p>
          Start with curated recommendation pages for high-search anime, then branch into
          the finder when you want a broader match by genre, tags, score, format, or studio.
        </p>
      </div>
      <a class="button primary" href="/similar/">Open finder</a>
    </div>
  </section>

  <section class="section guide-grid">
    {curated.map((anime) => {
      const guide = manualSimilarGuideFor(anime.id);
      const label = `Anime like ${displayTitle(anime)}`;
      return (
        <article class="guide-card">
          <p class="eyebrow">Curated guide</p>
          <h2><a href={`/anime-like/${animeLikeSlug(anime)}/`}>{label}</a></h2>
          <p>{guide?.intro || `Recommendations for fans searching for shows similar to ${displayTitle(anime)}.`}</p>
          <a class="button small" href={`/anime-like/${animeLikeSlug(anime)}/`} data-track-event="related_guide_click" data-track-label={label}>Open guide</a>
        </article>
      );
    })}
  </section>

  <section class="section split-feature">
    <div class="editor-note">
      <p class="eyebrow">Review standard</p>
      <h2>Why only six guides are public</h2>
      <p>Each public guide has a manual thesis, named match angles, title-specific recommendation notes, a reader-fit section, and an FAQ. The wider catalog remains available through the finder without creating hundreds of repetitive pages.</p>
    </div>
    <div class="editor-note">
      <p class="eyebrow">Editorial method</p>
      <h2>Data proposes; an editor explains</h2>
      <p>AniList recommendation and catalog signals create a candidate pool. Airing Atlas then explains the actual viewing reason: tone, structure, character pressure, moral conflict, or emotional payoff.</p>
      <a class="button small" href="/editorial-policy/">Read the editorial policy</a>
    </div>
  </section>
</BaseLayout>
