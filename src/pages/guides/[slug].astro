---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdSlot from "@/components/AdSlot.astro";
import { canonicalPath } from "@/lib/anime";
import { guides, type EditorialGuide } from "@/lib/guides";
import { breadcrumbJsonLd } from "@/lib/seo";

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props as { guide: EditorialGuide };
const canonical = `/guides/${guide.slug}/`;
const activeGuides = guides.filter((item) => item.indexStatus === "active");
const activeGuideIndex = activeGuides.findIndex((item) => item.slug === guide.slug);
const relatedActiveGuides = activeGuideIndex >= 0
  ? [1, 2, 3].map((offset) => activeGuides[(activeGuideIndex + offset) % activeGuides.length])
  : activeGuides.slice(0, 3);
const structuredData = [
  breadcrumbJsonLd([
    { name: "Airing Atlas", path: "/" },
    { name: "Guides", path: "/guides/" },
    { name: guide.title, path: canonical }
  ]),
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: guide.title,
    description: guide.description,
    dateModified: guide.updated,
    datePublished: guide.updated,
    author: {
      "@type": "Organization",
      name: "Airing Atlas"
    },
    publisher: {
      "@type": "Organization",
      name: "Airing Atlas",
      logo: {
        "@type": "ImageObject",
        url: canonicalPath("/og-default.svg")
      }
    },
    mainEntityOfPage: canonicalPath(canonical)
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: guide.faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  canonical={canonicalPath(canonical)}
  structuredData={structuredData}
  adsEnabled={guide.adsEligible}
>
  <article class="article-page">
    <section class="article-hero">
      <p class="eyebrow">Airing Atlas guide · Updated {guide.updated}</p>
      <h1>{guide.title}</h1>
      <p class="lede">{guide.lede}</p>
      <div class="article-byline" aria-label="Article information">
        <div><span>Written and reviewed by</span><strong>Airing Atlas Editorial Desk</strong></div>
        <div><span>Evidence layer</span><strong>AniList data + manual editorial judgment</strong></div>
        <div><span>Commercial policy</span><strong>Recommendations are not paid placements</strong></div>
      </div>
    </section>

    <section class="section">
      <div class="editor-note">
        <p class="eyebrow">Main idea</p>
        <h2>The useful rule</h2>
        <p>{guide.thesis}</p>
      </div>
    </section>

    <section class="section article-body">
      {guide.sections.map((section) => (
        <section class="article-section">
          <p class="eyebrow">{section.eyebrow}</p>
          <h2>{section.heading}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      ))}
    </section>

    {guide.comparisonRows?.length && (
      <section class="section">
        <div class="keyword-panel">
          <p class="eyebrow">Status reference</p>
          <h2>Anime release status compared</h2>
          <div class="guide-comparison-wrap">
            <table class="guide-comparison">
              <caption class="sr-only">Anime release status meanings and viewer impact</caption>
              <thead>
                <tr><th>Status</th><th>What it means</th><th>What it means for viewers</th></tr>
              </thead>
              <tbody>
                {guide.comparisonRows.map((row) => (
                  <tr><th scope="row">{row.status}</th><td>{row.meaning}</td><td>{row.viewerImpact}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    )}

    <section class="section split-feature">
      <div class="editor-note">
        <p class="eyebrow">Checklist</p>
        <h2>Use this before choosing</h2>
        <ul class="plain-list">
          {guide.checklist.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="keyword-panel">
        <p class="eyebrow">Next routes</p>
        <h2>Apply the guide</h2>
        <div class="keyword-list">
          {guide.internalLinks.map((link) => (
            <a href={link.href} data-track-event="editorial_guide_internal_click" data-track-label={link.label}>
              <span>{link.note}</span>
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="keyword-panel">
        <p class="eyebrow">FAQ</p>
        <h2>Common questions</h2>
        <div class="faq-grid">
          {guide.faq.map((item) => (
            <article>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="keyword-panel">
        <p class="eyebrow">Continue reading</p>
        <h2>Related original guides</h2>
        <div class="keyword-list">
          {relatedActiveGuides.map((item) => (
            <a href={`/guides/${item.slug}/`} data-track-event="editorial_guide_internal_click" data-track-label={item.title}>
              <span>{item.description}</span>
              {item.title}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section editorial-disclosure">
      <div>
        <p class="eyebrow">How this guide was made</p>
        <h2>Editorial notes and corrections</h2>
        <p>
          This article is original Airing Atlas editorial content. Catalog facts
          use AniList as the structured source; recommendations and viewing rules
          are written and reviewed by the Airing Atlas Editorial Desk. Advertising
          does not determine the conclusions or linked titles.
        </p>
      </div>
      <div class="button-row">
        <a class="button small" href="/">Airing Atlas home</a>
        <a class="button small" href="/guides/">All guides</a>
        <a class="button small" href="/editorial-policy/">Editorial policy</a>
        <a class="button small" href="/contact/">Report a correction</a>
      </div>
    </section>

    {guide.adsEligible && (
      <section class="section">
        <AdSlot />
      </section>
    )}
  </article>
</BaseLayout>
