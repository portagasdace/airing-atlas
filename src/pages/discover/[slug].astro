---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { allAnime, animeByIds, canonicalPath, displayTitle, watchOrderIndex } from "@/lib/anime";
import { clusterReason, discoveryClusters, rankedClusterAnime, type DiscoveryCluster } from "@/lib/discovery-clusters";
import { qualityWatchOrderFor } from "@/lib/manual-content";
import { adsenseReviewWatchOrderGuides } from "@/lib/quality";
import { animeLikeGuideHref, hasPublicAnimeLikeGuide } from "@/lib/search-intents";
import { collectionPageJsonLd } from "@/lib/seo";
import { isAdsenseReviewDiscover } from "@/lib/review-mode";

export function getStaticPaths() {
  return discoveryClusters.filter((cluster) => isAdsenseReviewDiscover(cluster.slug)).map((cluster) => ({
    params: { slug: cluster.slug },
    props: { cluster }
  }));
}

const { cluster } = Astro.props as { cluster: DiscoveryCluster };
const isIndexable = isAdsenseReviewDiscover(cluster.slug);
const ranked = rankedClusterAnime(cluster, allAnime);
const highlighted = animeByIds(cluster.highlightAnimeIds);
const featured = [...highlighted, ...ranked]
  .filter((anime, index, items) => items.findIndex((item) => item.id === anime.id) === index)
  .slice(0, 8);
const relatedGuides = animeByIds(cluster.relatedGuideIds).slice(0, 6);
const publicGuideSlugs = new Set(adsenseReviewWatchOrderGuides(watchOrderIndex.items).map((guide) => guide.slug));
const title = `Best ${cluster.title} to Watch: Picks and Related Guides`;
const canonical = `/discover/${cluster.slug}/`;
const plannerPresetBySlug: Record<string, { time: string; mood: string; length: string; finished: string; label: string }> = {
  "dark-fantasy-anime": { time: "night", mood: "dark", length: "short", finished: "true", label: "Build a dark one-night plan" },
  "battle-shounen-anime": { time: "long", mood: "action", length: "long", finished: "false", label: "Build a battle shounen route" },
  "mind-game-anime": { time: "month", mood: "mind", length: "any", finished: "true", label: "Build a mind-game month plan" },
  "long-running-adventure-anime": { time: "long", mood: "adventure", length: "long", finished: "false", label: "Build a long adventure route" },
  "supernatural-action-anime": { time: "weekend", mood: "dark", length: "medium", finished: "true", label: "Build a supernatural action plan" },
  "emotional-drama-anime": { time: "weekend", mood: "emotional", length: "medium", finished: "true", label: "Build an emotional weekend plan" },
  "romance-drama-anime": { time: "weekend", mood: "romance", length: "medium", finished: "true", label: "Build a romance weekend plan" },
  "anime-with-smart-main-character": { time: "month", mood: "mind", length: "any", finished: "true", label: "Build a smart-lead watch plan" }
};
const clusterPreset = plannerPresetBySlug[cluster.slug] || { time: "weekend", mood: "balanced", length: "any", finished: "true", label: "Build a watch plan" };
const plannerHref = `/binge-planner/?time=${clusterPreset.time}&mood=${clusterPreset.mood}&length=${clusterPreset.length}&finished=${clusterPreset.finished}&source=cluster_cta`;
const watchNextHref = `/watch-next/?mood=${clusterPreset.mood}&status=${clusterPreset.finished === "true" ? "finished" : "either"}`;
const anchorAnime = highlighted[0] || featured[0];
const animeLikeHref = anchorAnime ? animeLikeGuideHref(anchorAnime) : "/anime-like/";
const animeLikeLabel = anchorAnime ? `Find anime like ${displayTitle(anchorAnime)}` : `Find anime like ${cluster.shortLabel}`;
const faqItems = [
  {
    question: `What counts as ${cluster.shortLabel.toLowerCase()} anime on Airing Atlas?`,
    answer: cluster.fitNote
  },
  {
    question: `How does Airing Atlas choose ${cluster.shortLabel.toLowerCase()} picks?`,
    answer: "Airing Atlas combines curated anchor titles with genre, tag, score, popularity, and catalog safety signals so the guide is useful for actual watch decisions."
  },
  {
    question: "Can I turn this guide into a watch plan?",
    answer: "Yes. Use the planner route on this page to build a shareable binge plan from the same mood and length signals."
  }
];
const structuredData = collectionPageJsonLd({
  name: cluster.title,
  description: cluster.description,
  path: canonical,
  items: featured
}).concat({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
});
---

<BaseLayout
  title={title}
  description={cluster.description}
  canonical={canonicalPath(canonical)}
  robots={isIndexable ? undefined : "noindex,follow"}
  structuredData={structuredData}
  adsEnabled={isIndexable}
>
  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Curated discovery</p>
        <h1>Best {cluster.title} to watch</h1>
        <p>{cluster.intro}</p>
      </div>
      <a class="button primary" href={`/discover/?q=${encodeURIComponent(cluster.shortLabel)}`} data-track-event="discover_cluster_open_filter" data-track-label={cluster.title}>Open filter</a>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Top picks</p>
        <h2>Best {cluster.shortLabel.toLowerCase()} anime to start with</h2>
        <p>These picks are ranked from curated anchors plus genre, tag, score, and popularity signals in the current Airing Atlas catalog.</p>
      </div>
    </div>
    <div class="guide-grid">
      {featured.map((anime, index) => (
        <article class="guide-card">
          <p class="eyebrow">#{index + 1} pick</p>
          <h2>{anime.siteUrl ? <a href={anime.siteUrl} target="_blank" rel="nofollow noopener">{displayTitle(anime)}</a> : displayTitle(anime)}</h2>
          <p>{clusterReason(cluster, anime)}</p>
          <div class="tag-row">
            {(anime.genres || []).slice(0, 4).map((genre) => <span>{genre}</span>)}
          </div>
          <div class="button-row">
            {anime.siteUrl && <a class="button small" href={anime.siteUrl} target="_blank" rel="nofollow noopener" data-track-event="discover_result_click" data-track-label={displayTitle(anime)} data-result-position={index + 1}>View on AniList</a>}
            <a class="button small" href={animeLikeGuideHref(anime)} data-track-event="related_guide_click" data-track-label={`Anime like ${displayTitle(anime)}`}>
              {hasPublicAnimeLikeGuide(anime) ? "Anime like this" : "Find similar"}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section split-feature">
    <div class="editor-note">
      <p class="eyebrow">Selection criteria</p>
      <h2>What this guide means</h2>
      <ul class="plain-list">
        {cluster.criteria.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="editor-note">
      <p class="eyebrow">Atlas take</p>
      <h2>Why these picks fit</h2>
      <p>{cluster.fitNote}</p>
    </div>
  </section>

  <section class="section guide-grid">
    <article class="guide-card">
      <p class="eyebrow">Best fit</p>
      <h2>Use this guide when the mood matters first</h2>
      <p>
        This page is useful when you know the kind of viewing experience you want
        before you know the exact title. It favors anime that match the guide's
        pressure, pacing, and audience signal rather than only sharing a genre tag.
      </p>
    </article>
    <article class="guide-card">
      <p class="eyebrow">Not a generic ranking</p>
      <h2>Why some famous titles may be missing</h2>
      <p>
        A title can be popular and still be a weak fit for this specific route.
        The list is scoped around {cluster.shortLabel.toLowerCase()} decision
        criteria, so it avoids turning every cluster into the same top-anime list.
      </p>
    </article>
    <article class="guide-card">
      <p class="eyebrow">Before starting</p>
      <h2>Check commitment and status</h2>
      <p>
        Check episode count, airing status, and whether a franchise watch order
        exists before committing. The live finder can narrow the same theme by
        length and release status.
      </p>
    </article>
    <article class="guide-card">
      <p class="eyebrow">Legal watching note</p>
      <h2>Guides without streams</h2>
      <p>
        Airing Atlas does not host episodes, downloads, manga scans, or unofficial
        streams. Use the guide for planning and official services in your region
        when you are ready to watch.
      </p>
    </article>
  </section>

  <section class="section" data-track-section="discover_cluster_decision_routes">
    <div class="decision-route-panel">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>Turn this guide into a watch decision</h2>
        <p>
          Use the same {cluster.shortLabel.toLowerCase()} signal to build a shareable plan,
          pick one anime for tonight, or branch into similar-title guides.
        </p>
      </div>
      <div class="decision-route-grid">
        <a class="decision-route primary-route" href={plannerHref} data-track-event="discover_cluster_planner_click" data-track-label={cluster.title}>
          <strong>{clusterPreset.label}</strong>
          <span>Creates a stable route with titles, reasons, and a copyable share link.</span>
        </a>
        <a class="decision-route" href={watchNextHref} data-track-event="discover_cluster_watch_next_click" data-track-label={cluster.title}>
          <strong>Pick one anime now</strong>
          <span>Open Watch Next with this guide's mood already selected.</span>
        </a>
        <a class="decision-route" href={animeLikeHref} data-track-event="discover_cluster_anime_like_click" data-track-label={animeLikeLabel}>
          <strong>{animeLikeLabel}</strong>
          <span>Branch from a known title into similar recommendations.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="editor-note">
      <p class="eyebrow">Related guides</p>
      <h2>Useful next routes</h2>
      <div class="link-stack">
        {relatedGuides.map((anime) => {
          const guide = qualityWatchOrderFor(anime.id);
          const publicGuide = guide && publicGuideSlugs.has(guide.slug) ? guide : undefined;
          const hasSimilarGuide = hasPublicAnimeLikeGuide(anime);
          return (
            <>
              {hasSimilarGuide && <a href={animeLikeGuideHref(anime)} data-track-event="related_guide_click" data-track-label={`Anime like ${displayTitle(anime)}`}>Anime like {displayTitle(anime)}</a>}
              {publicGuide && <a href={`/watch-order/${publicGuide.slug}/`} data-track-event="related_guide_click" data-track-label={publicGuide.title}>{publicGuide.title}</a>}
            </>
          );
        })}
      </div>
    </div>
  </section>

</BaseLayout>
