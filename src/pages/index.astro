---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { allAnime, animeById, canonicalPath, displayTitle, watchOrderIndex } from "@/lib/anime";
import { discoveryClusters } from "@/lib/discovery-clusters";
import { guides } from "@/lib/guides";
import { manualSimilarGuideFor } from "@/lib/manual-content";
import { adsenseReviewAnimeLikePages, adsenseReviewWatchOrderGuides } from "@/lib/quality";
import { ADSENSE_REVIEW_DISCOVER_SLUGS } from "@/lib/review-mode";
import { animeLikeSlug } from "@/lib/search-intents";
import { websiteJsonLd } from "@/lib/seo";

const featuredGuideSlugs = [
  "how-many-episodes-before-dropping-an-anime",
  "how-long-does-it-take-to-watch-an-anime",
  "are-anime-recap-movies-worth-watching",
  "how-to-build-an-anime-watchlist"
];
const featuredEditorialGuides = featuredGuideSlugs
  .map((slug) => guides.find((guide) => guide.slug === slug))
  .filter((guide): guide is (typeof guides)[number] => Boolean(guide));
const guideShelfSlugs = [
  "how-to-choose-anime-by-mood",
  "watch-order-vs-release-order",
  "best-anime-for-beginners",
  "what-does-finished-airing-mean-in-anime"
];
const guideShelf = guideShelfSlugs
  .map((slug) => guides.find((guide) => guide.slug === slug))
  .filter((guide): guide is (typeof guides)[number] => Boolean(guide));
const featuredClusters = discoveryClusters.filter((cluster) =>
  ADSENSE_REVIEW_DISCOVER_SLUGS.includes(cluster.slug as (typeof ADSENSE_REVIEW_DISCOVER_SLUGS)[number])
);
const watchGuides = adsenseReviewWatchOrderGuides(watchOrderIndex.items);
const allSimilarGuides = adsenseReviewAnimeLikePages(allAnime);
const similarGuides = allSimilarGuides.slice(0, 3);
const jujutsuGuide = watchGuides.find((guide) => guide.rootAnimeId === 113415) || watchGuides[0];
const attackOnTitan = animeById(16498);
const demonSlayer = animeById(101922);
const plannerPresets = [
  {
    label: "One-night dark anime",
    detail: "Short finished route with monsters, curses, and survival pressure.",
    href: "/binge-planner/?time=night&mood=dark&length=short&finished=true&source=home_preset",
    trackLabel: "One-night dark anime"
  },
  {
    label: "Weekend romance",
    detail: "A compact finished romance drama route for a weekend watch.",
    href: "/binge-planner/?time=weekend&mood=romance&length=medium&finished=true&source=home_preset",
    trackLabel: "Weekend romance"
  },
  {
    label: "Mind-game month plan",
    detail: "Strategy, deduction, and psychological pressure across a longer plan.",
    href: "/binge-planner/?time=month&mood=mind&length=any&finished=true&source=home_preset",
    trackLabel: "Mind-game month plan"
  },
  {
    label: "Long adventure route",
    detail: "Bigger franchises and ongoing journeys for a long watchlist project.",
    href: "/binge-planner/?time=long&mood=adventure&length=long&finished=false&source=home_preset",
    trackLabel: "Long adventure route"
  }
];
const keywordPaths = [
  { label: "original anime watching guides", href: "/guides/", intent: "Editorial library" },
  { label: "anime finder by mood", href: "/anime-finder/", intent: "Anime finder" },
  { label: "anime binge planner", href: "/binge-planner/", intent: "Shareable planner" },
  { label: "what anime should I watch next", href: "/watch-next/", intent: "Decision tool" },
  { label: "finished anime to watch", href: "/finished-anime/", intent: "Binge finder" },
  { label: "anime watch order", href: "/watch-order/", intent: "Watch order" },
  attackOnTitan && { label: "anime like Attack on Titan", href: `/anime-like/${animeLikeSlug(attackOnTitan)}/`, intent: "Similar guide" },
  demonSlayer && { label: "anime like Demon Slayer", href: `/anime-like/${animeLikeSlug(demonSlayer)}/`, intent: "Similar guide" },
  jujutsuGuide && { label: "Jujutsu Kaisen watch order", href: `/watch-order/${jujutsuGuide.slug}/`, intent: "Watch order" },
  ...featuredClusters.map((cluster) => ({
    label: cluster.title.toLowerCase(),
    href: `/discover/${cluster.slug}/`,
    intent: "Discovery"
  }))
].filter((item): item is { label: string; href: string; intent: string } => Boolean(item)).slice(0, 12);
---

<BaseLayout
  title="Airing Atlas: Independent Anime Guides & Watch Planner"
  description="Read original anime decision guides, compare curated recommendations, follow manual watch orders, and build a realistic watch plan without unofficial streams."
  canonical={canonicalPath("/")}
  structuredData={websiteJsonLd()}
  adsEnabled={false}
>
  <section class="hero" data-track-section="home_hero">
    <div class="hero-copy">
      <p class="eyebrow">Independent anime decision guides</p>
      <h1>Airing Atlas</h1>
      <p class="lede">
        Get a clear answer before you spend hours watching: choose by mood, estimate
        the commitment, separate required franchise entries, and build a realistic route.
      </p>
      <div class="hero-actions hero-secondary-actions">
        <a class="button primary" href="/guides/" data-track-event="home_primary_guides" data-track-label="Editorial guides">Read original guides</a>
        <a class="button" href="/anime-finder/" data-track-event="home_primary_anime_finder" data-track-label="Anime finder">Find anime by mood</a>
        <a class="button" href="/binge-planner/" data-track-event="home_primary_binge_planner" data-track-label="Open blank binge planner">Build a plan</a>
      </div>
      <div class="hero-preset-grid" aria-label="Start with a binge plan preset">
        {plannerPresets.map((preset) => (
          <a
            class="hero-preset"
            href={preset.href}
            data-track-event="home_binge_preset_click"
            data-track-label={preset.trackLabel}
          >
            <strong>{preset.label}</strong>
            <span>{preset.detail}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="ticker-panel editorial-shelf">
      <p class="eyebrow">Start with an editor's answer</p>
      <h2>Four decisions that prevent a bad watch</h2>
      <div class="editorial-shelf-list">
        {guideShelf.map((guide, index) => (
          <a href={`/guides/${guide.slug}/`} data-track-event="home_editorial_guide_click" data-track-label={guide.title}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{guide.shortTitle}</strong>
            <small>{guide.thesis}</small>
          </a>
        ))}
      </div>
      <a class="button shelf-button" href="/editorial-policy/">How we research guides</a>
    </div>
  </section>

  <section class="section daily-desk" aria-label="New editorial guides" data-track-section="home_editorial_updates">
    <div>
      <p class="eyebrow">New from the editorial desk</p>
      <h2>Practical answers, not another title dump</h2>
      <p>
        These guides address the decisions that catalog scores cannot make for you:
        when to stop, what to skip, how much time a route takes, and how to keep a usable queue.
      </p>
    </div>
    <div class="mini-list">
      {featuredEditorialGuides.map((guide, index) => (
        <a href={`/guides/${guide.slug}/`} data-track-event="home_editorial_guide_click" data-track-label={guide.title} data-result-position={index + 1}>
          <span>{index + 1}</span>
          <strong>{guide.shortTitle}</strong>
          <small>Updated {guide.updated}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="section quick-entry-grid" aria-label="Start with a tool" data-track-section="home_tool_grid">
    <a class="quick-entry primary-entry" href="/guides/" data-track-event="home_tool_guides" data-track-label="Editorial guides">
      <span class="eyebrow">Understand</span>
      <strong>Read original guides</strong>
      <small>Use practical rules for status, watch time, recap movies, and watchlist decisions.</small>
    </a>
    <a class="quick-entry" href="/anime-finder/" data-track-event="home_tool_anime_finder" data-track-label="Anime finder">
      <span class="eyebrow">Pick now</span>
      <strong>Find anime by mood</strong>
      <small>Choose mood, length, and status to get instant recommendations.</small>
    </a>
    <a class="quick-entry" href="/binge-planner/" data-track-event="home_tool_binge_planner" data-track-label="Binge planner">
      <span class="eyebrow">Share</span>
      <strong>Build a binge plan</strong>
      <small>Create a 3-6 title route and copy a stable share link.</small>
    </a>
    <a class="quick-entry" href="/anime-like/" data-track-event="home_tool_anime_like" data-track-label="Anime like guides">
      <span class="eyebrow">Guides</span>
      <strong>Anime like X</strong>
      <small>Curated pages for Attack on Titan, Demon Slayer, Jujutsu Kaisen, and more.</small>
    </a>
    <a class="quick-entry" href="/watch-order/" data-track-event="home_tool_watch_order" data-track-label="Watch order hub">
      <span class="eyebrow">Franchise</span>
      <strong>Watch order guides</strong>
      <small>Curated paths for long series, sequels, movies, and optional entries.</small>
    </a>
  </section>

  <section class="section split-feature" data-track-section="home_editorial_value">
    <div class="editor-note">
      <p class="eyebrow">Atlas method</p>
      <h2>More than an anime database</h2>
      <p>
        Airing Atlas uses public anime data as a starting point, then turns it
        into practical decisions: what airs next, what to watch after a favorite,
        which franchise entries matter, and which completed shows fit your time.
      </p>
    </div>
    <div class="editor-note">
      <p class="eyebrow">Editorial independence</p>
      <h2>Guides without paid placements</h2>
      <p>
        Advertising never determines recommendation order. The site does not host
        episodes, downloads, or unofficial streams, and each public guide explains
        its reasoning and limits.
      </p>
      <a class="button small" href="/editorial-policy/">Read the policy</a>
    </div>
  </section>

  <section class="feature-band" aria-label="Catalog stats">
    <div class="section">
      <div class="stat-tile"><strong>{guides.length}</strong><span>original decision guides</span></div>
      <div class="stat-tile"><strong>{allSimilarGuides.length}</strong><span>manual similar-anime guides</span></div>
      <div class="stat-tile"><strong>{watchGuides.length}</strong><span>manual franchise routes</span></div>
      <div class="stat-tile"><strong>{featuredClusters.length}</strong><span>focused discovery themes</span></div>
    </div>
  </section>

  <section class="section">
    <div class="keyword-panel" data-track-section="home_popular_guides">
      <p class="eyebrow">Search paths</p>
      <h2>Popular anime guides</h2>
      <p>Every linked content page below is part of the small editorial review set. Broader catalog exploration stays inside the live tools.</p>
      <div class="keyword-list">
        {keywordPaths.map((item) => (
          <a href={item.href} data-track-event="related_guide_click" data-track-label={item.label}>
            <span>{item.intent}</span>
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Human-edited examples</p>
        <h2>Three ways a similar-anime guide can be specific</h2>
        <p>
          Each public recommendation page starts with a real reference title, then
          explains match angles and tradeoffs instead of returning a generic genre list.
        </p>
      </div>
      <a class="button" href="/anime-like/">All six guides</a>
    </div>
    <div class="recommendation-grid">
      {similarGuides.map((anime) => {
        const guide = manualSimilarGuideFor(anime.id);
        return (
          <article class="recommendation-card">
            <a class="result-poster" href={`/anime-like/${animeLikeSlug(anime)}/`}>
              <img src={anime.coverImage?.large || anime.coverImage?.extraLarge || "/og-default.svg"} alt="" width="104" height="146" loading="lazy" referrerpolicy="no-referrer" />
            </a>
            <div>
              <p class="eyebrow">Manual recommendation guide</p>
              <h3><a href={`/anime-like/${animeLikeSlug(anime)}/`}>Anime like {displayTitle(anime)}</a></h3>
              <p>{guide?.whySimilar || guide?.intro}</p>
              <a class="button small" href={`/anime-like/${animeLikeSlug(anime)}/`}>Read the guide</a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section split-feature">
    <div>
      <div class="section-header">
        <div>
          <p class="eyebrow">Focused discovery</p>
          <h2>Four public theme guides</h2>
          <p>
            These routes are kept small on purpose. Each has a defined selection rule;
            the broader catalog remains in the non-indexed filter tool.
          </p>
        </div>
      </div>
      <div class="chip-grid">
        {featuredClusters.map((cluster) => <a href={`/discover/${cluster.slug}/`}>{cluster.shortLabel}<span>guide</span></a>)}
      </div>
    </div>
    <div>
      <div class="section-header">
        <div>
          <p class="eyebrow">Franchise maps</p>
          <h2>Watch order guides</h2>
          <p>Curated franchise paths that keep anime entries separate from manga sources and recap-only pages.</p>
        </div>
      </div>
      <div class="link-stack">
        {watchGuides.map((guide) => <a href={`/watch-order/${guide.slug}/`} data-track-event="related_guide_click" data-track-label={guide.title}>{guide.title}</a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Focused paths</p>
        <h2>Choose one useful next action</h2>
        <p>
          Read the decision rule first, then use a tool or a curated franchise route
          instead of opening dozens of anonymous catalog pages.
        </p>
      </div>
      <a class="button" href="/watchlist/" data-track-event="home_secondary_watchlist" data-track-label="Watchlist">Open watchlist</a>
    </div>
    <div class="link-stack" data-track-section="home_focused_paths">
      <a href="/guides/" data-track-event="related_guide_click" data-track-label="Editorial guides">Read original decision guides</a>
      <a href="/binge-planner/" data-track-event="related_guide_click" data-track-label="Binge planner">Build a binge plan</a>
      <a href="/anime-like/" data-track-event="related_guide_click" data-track-label="Anime like hub">Find anime like a favorite</a>
      <a href="/watch-order/" data-track-event="related_guide_click" data-track-label="Watch order hub">Check a watch order</a>
      <a href="/editorial-policy/" data-track-event="related_guide_click" data-track-label="Editorial policy">Review the editorial method</a>
    </div>
  </section>
</BaseLayout>
