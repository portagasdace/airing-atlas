---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { canonicalPath, fuzzyDateLabel, titleCase, watchOrderIndex } from "@/lib/anime";
import { entriesForManualOrder, manualWatchOrderFor, watchOrderQualityEntries } from "@/lib/manual-content";
import { adsenseReviewWatchOrderGuides } from "@/lib/quality";
import { watchOrderJsonLd } from "@/lib/seo";
import type { WatchOrderGuide } from "@/types/anime";

export function getStaticPaths() {
  return adsenseReviewWatchOrderGuides(watchOrderIndex.items).map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props as { guide: WatchOrderGuide };
const franchiseTitle = titleCase(guide.title.replace(/\s+watch order$/i, "").trim());
const manual = manualWatchOrderFor(guide.rootAnimeId);
const pageTitle = manual?.seoTitle || `${franchiseTitle} Watch Order: Story, Release, Movies & OVAs`;
const pageDescription = manual?.seoDescription || `Follow the ${franchiseTitle} watch order by story path, release order, movies, OVAs, specials, and optional entries.`;
const publicGuideSlugs = new Set(adsenseReviewWatchOrderGuides(watchOrderIndex.items).map((item) => item.slug));
const isIndexable = publicGuideSlugs.has(guide.slug);
const qualityEntries = watchOrderQualityEntries(guide);
const mainRelations = new Set(["MAIN", "PREQUEL", "SEQUEL"]);
const optionalRelations = new Set(["OVA", "ONA", "SPECIAL", "SPIN_OFF", "SIDE_STORY", "SUMMARY", "ALTERNATIVE"]);
const manualRecommendedOrder = manual ? entriesForManualOrder(manual.recommendedOrder, guide, "MAIN") : [];
const manualReleaseOrder = manual ? entriesForManualOrder(manual.releaseOrder, guide, "RELATED") : [];
const manualOptionalEntries = manual ? entriesForManualOrder(manual.optionalEntries, guide, "SIDE_STORY") : [];
const recommendedOrder = manualRecommendedOrder.length
  ? manualRecommendedOrder
  : qualityEntries.filter((entry) => mainRelations.has(String(entry.relationType || "").toUpperCase()));
const releaseOrder = manualReleaseOrder.length
  ? manualReleaseOrder
  : [...qualityEntries].sort((a, b) => dateRank(a.startDate) - dateRank(b.startDate));
const optionalEntries = (manualOptionalEntries.length ? manualOptionalEntries : qualityEntries.filter((entry) => optionalRelations.has(String(entry.relationType || "").toUpperCase())))
  .filter((entry) => !recommendedOrder.some((mainEntry) => mainEntry.animeId === entry.animeId));
const coreMovieCount = recommendedOrder.filter((entry) => String(entry.format || "").toUpperCase() === "MOVIE").length;
const coreMovieTitles = recommendedOrder
  .filter((entry) => String(entry.format || "").toUpperCase() === "MOVIE")
  .map((entry) => entry.title);
const mainRouteLabel = recommendedOrder.map((entry) => entry.title).join(" → ");
const automaticFaqItems = [
  {
    question: `What is the ${franchiseTitle} watch order?`,
    answer: mainRouteLabel
      ? `The recommended first-watch route is ${mainRouteLabel}. Optional movies, OVAs, specials, and recap entries can wait unless the route labels them as core story material.`
      : `Start with the main ${franchiseTitle} series, then follow direct sequels before optional movies, OVAs, specials, or recap entries.`
  },
  {
    question: `How many ${franchiseTitle} movies are in the main watch order?`,
    answer: coreMovieCount
      ? `The current recommended route contains ${coreMovieCount} core ${coreMovieCount === 1 ? "movie" : "movies"}: ${coreMovieTitles.join(", ")}. Other movie-format entries listed as optional or recap material are not required for the main route.`
      : `The current recommended route contains no required movies. Any movie-format entries listed below are optional, alternate, or recap material unless the guide says otherwise.`
  }
];
const schemaEntries = uniqueEntries([...recommendedOrder, ...releaseOrder, ...optionalEntries]).slice(0, 14);
const schemaGuide = { ...guide, title: pageTitle, entries: schemaEntries.length >= 3 ? schemaEntries : qualityEntries };
const editorialFaqItems = manual?.faq || [
  {
    question: "What is the best order?",
    answer: "Use the recommended order for story flow, then check release order if you want the original broadcast context."
  },
  {
    question: "Can I skip recap movies?",
    answer: "Usually yes. Entries labeled alternative or summary are often best saved as refreshers."
  },
  {
    question: "Are OVAs and specials required?",
    answer: "Most are optional side material unless the guide labels them as direct prequel or sequel content."
  },
  {
    question: "Does Airing Atlas stream anime?",
    answer: "No. Airing Atlas is a franchise map, release schedule, and discovery tool; it does not host episodes."
  }
];
const faqItems = uniqueFaq([...automaticFaqItems, ...editorialFaqItems]);

function dateRank(date: WatchOrderGuide["entries"][number]["startDate"]) {
  if (!date?.year) return Number.MAX_SAFE_INTEGER;
  return Number(`${date.year}${String(date.month || 1).padStart(2, "0")}${String(date.day || 1).padStart(2, "0")}`);
}

function uniqueEntries(entries: WatchOrderGuide["entries"]) {
  const seen = new Set<number>();
  return entries.filter((entry) => {
    if (seen.has(entry.animeId)) return false;
    seen.add(entry.animeId);
    return true;
  });
}

function uniqueFaq(items: Array<{ question: string; answer: string }>) {
  const seen = new Set<string>();
  return items.filter((item) => {
    const key = item.question.trim().toLowerCase();
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalPath(`/watch-order/${guide.slug}/`)}
  robots={isIndexable ? undefined : "noindex,follow"}
  structuredData={watchOrderJsonLd(schemaGuide, faqItems, {
    headline: pageTitle,
    description: pageDescription,
    updated: manual?.updated
  })}
  adsEnabled={isIndexable}
>
  <section class="section watch-order-hero">
    <div class="section-header">
      <div>
        <p class="eyebrow">Suggested viewing order</p>
        <h1>{pageTitle}</h1>
        <p>{manual?.intro || guide.description} Use this as a franchise map, not a replacement for official release information.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="editor-note">
      <p class="eyebrow">Quick answer</p>
      <h2>{recommendedOrder.length ? `${franchiseTitle} in ${recommendedOrder.length} main steps` : `Start ${franchiseTitle} here`}</h2>
      <p>
        {manual?.quickAnswer || manual?.intro || "Follow the main path first, then add side stories, OVAs, specials, and recap movies after the closest related season."}
      </p>
      {mainRouteLabel && <p class="watch-order-route-answer"><strong>{mainRouteLabel}</strong></p>}
      <div class="chip-grid">
        {recommendedOrder.slice(0, 10).map((entry, index) => (
          entry.siteUrl
            ? <a href={entry.siteUrl} target="_blank" rel="nofollow noopener" data-track-event="watch_order_entry_click" data-track-label={entry.title}><span>{index + 1}</span>{entry.title}</a>
            : <span><b>{index + 1}</b>{entry.title}</span>
        ))}
      </div>
      <div class="compact-facts watch-order-facts" aria-label={`${franchiseTitle} route facts`}>
        <div><span>Main route</span><strong>{recommendedOrder.length} entries</strong></div>
        <div><span>Core movies</span><strong>{coreMovieCount}</strong></div>
        <div><span>Can wait or skip</span><strong>{optionalEntries.length} extras</strong></div>
      </div>
      <div class="article-byline" aria-label="Guide information">
        <div><span>Written and reviewed by</span><strong>Airing Atlas Editorial Desk</strong></div>
        <div><span>Last route review</span><strong>{manual?.updated || "Current catalog build"}</strong></div>
        <div><span>Editorial method</span><strong>Manual route review + AniList catalog data</strong></div>
      </div>
      <div class="button-row">
        <a class="button small" href="/watch-order/">All watch-order guides</a>
        <a class="button small" href="/editorial-policy/">Editorial method</a>
      </div>
    </div>
  </section>

  <section class="section guide-grid">
    <article class="guide-card">
      <p class="eyebrow">Best fit</p>
      <h2>Use story order for a first run</h2>
      <p>
        This route is designed for viewers who want to start the franchise
        without turning every movie, OVA, special, or recap into a required step.
      </p>
    </article>
    <article class="guide-card">
      <p class="eyebrow">Not required</p>
      <h2>Completionist material can wait</h2>
      <p>
        Release order and optional entries are included for context, but the
        recommended route is the safer default when you care about story flow.
      </p>
    </article>
    <article class="guide-card">
      <p class="eyebrow">Before starting</p>
      <h2>Check movie and OVA labels</h2>
      <p>
        Movies, OVAs, specials, spin-offs, and recap entries do different jobs.
        Use the optional notes before assuming a format is essential.
      </p>
    </article>
    <article class="guide-card">
      <p class="eyebrow">Legal watching note</p>
      <h2>Route only, not playback</h2>
      <p>
        Airing Atlas does not host episodes, downloads, or unofficial streams.
        Use official services and regional rights holders when you are ready to
        watch.
      </p>
    </article>
  </section>

  <section class="section timeline-list">
    {recommendedOrder.map((entry, index) => (
      <article class="timeline-item">
        <span class="timeline-rank">{index + 1}</span>
        <img src={entry.coverImage || "/og-default.svg"} alt="" width="96" height="134" loading="lazy" referrerpolicy="no-referrer" />
        <div>
          <p class="eyebrow">{titleCase(entry.relationType || "Related")}</p>
          <h2>{entry.siteUrl ? <a href={entry.siteUrl} target="_blank" rel="nofollow noopener" data-track-event="watch_order_entry_click" data-track-label={entry.title}>{entry.title}</a> : entry.title}</h2>
          <p>{titleCase(entry.format || "Anime")} · {fuzzyDateLabel(entry.startDate)} · {entry.episodes ? `${entry.episodes} episodes` : "Episodes TBA"}</p>
        </div>
      </article>
    ))}
  </section>

  <section class="section split-feature">
    <div class="editor-note">
      <p class="eyebrow">Release order</p>
      <h2>Original release path</h2>
      <p>Use this if you prefer to watch the franchise as audiences encountered it over time.</p>
      <div class="link-stack">
        {releaseOrder.slice(0, 12).map((entry) => (
          entry.siteUrl
            ? <a href={entry.siteUrl} target="_blank" rel="nofollow noopener" data-track-event="watch_order_entry_click" data-track-label={entry.title}>{fuzzyDateLabel(entry.startDate)} · {entry.title}</a>
            : <span>{fuzzyDateLabel(entry.startDate)} · {entry.title}</span>
        ))}
      </div>
    </div>
    <div class="editor-note">
      <p class="eyebrow">Skip and OVA notes</p>
      <h2>Optional material</h2>
      <p>{manual?.skipNotes || "Recap movies and alternative versions are usually optional if you already watched the corresponding TV season. OVAs, specials, side stories, and spin-offs are best treated as bonus material unless they are labeled prequel or sequel."}</p>
      <div class="link-stack">
        {optionalEntries.slice(0, 10).map((entry) => (
          entry.siteUrl
            ? <a href={entry.siteUrl} target="_blank" rel="nofollow noopener" data-track-event="watch_order_entry_click" data-track-label={entry.title}>{titleCase(entry.relationType || "Related")} · {entry.title}</a>
            : <span>{titleCase(entry.relationType || "Related")} · {entry.title}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="editor-note">
      <p class="eyebrow">Legal watching note</p>
      <p>{manual?.legalWatchingNote || "Airing Atlas does not host episodes, downloads, or unofficial streams. Use official services and regional rights holders when you are ready to watch."}</p>
    </div>
  </section>

  <section class="section">
    <div class="keyword-panel">
      <p class="eyebrow">Watch order FAQ</p>
      <h2>{guide.title} questions</h2>
      <div class="faq-grid">
        {faqItems.map((item) => (
          <article>
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
