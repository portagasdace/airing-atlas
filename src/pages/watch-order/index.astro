---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdSlot from "@/components/AdSlot.astro";
import { canonicalPath, watchOrderIndex } from "@/lib/anime";
import { manualWatchOrderByAnimeId, watchOrderQualityEntries } from "@/lib/manual-content";
import { adsenseReviewWatchOrderGuides } from "@/lib/quality";
import { breadcrumbJsonLd } from "@/lib/seo";

const guides = adsenseReviewWatchOrderGuides(watchOrderIndex.items);
const title = "Anime Watch Order Guides: Demon Slayer, Attack on Titan & More";
const description = "Browse anime watch order guides for Demon Slayer, Attack on Titan, Jujutsu Kaisen, Naruto, One Piece, movies, OVAs, specials, and sequels.";
const featuredRootIds = [101922, 16498, 113415, 20, 21];
const featuredGuides = featuredRootIds
  .map((id) => guides.find((guide) => guide.rootAnimeId === id))
  .filter((guide): guide is (typeof guides)[number] => Boolean(guide));
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalPath("/watch-order/")}
  structuredData={[
    breadcrumbJsonLd([
      { name: "Airing Atlas", path: "/" },
      { name: "Watch Order", path: "/watch-order/" }
    ]),
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: title,
      description,
      url: canonicalPath("/watch-order/"),
      mainEntity: {
        "@type": "ItemList",
        itemListElement: guides.slice(0, 24).map((guide, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: guide.title,
          url: canonicalPath(`/watch-order/${guide.slug}/`)
        }))
      }
    }
  ]}
  adsEnabled={true}
>
  <section class="section">
    <div class="section-header">
      <div>
        <p class="eyebrow">Franchise map</p>
        <h1>Anime Watch Order</h1>
        <p>
          Start with high-signal watch order guides for Demon Slayer, Attack on Titan,
          Jujutsu Kaisen, Naruto, One Piece, connected seasons, movies, OVAs, and specials.
        </p>
      </div>
      <a class="button primary" href="/discover/">Find a title</a>
    </div>
  </section>

  {featuredGuides.length > 0 && (
    <section class="section">
      <div class="keyword-panel" data-track-section="watch_order_popular_shortcuts">
        <p class="eyebrow">Popular searches</p>
        <h2>Start with a high-demand watch order</h2>
        <p>These routes match the most common franchise questions and keep main story paths separate from optional movies, OVAs, and specials.</p>
        <div class="keyword-list">
          {featuredGuides.map((guide) => (
            <a href={`/watch-order/${guide.slug}/`} data-track-event="watch_order_popular_click" data-track-label={guide.title}>
              <span>Watch order</span>
              {guide.title}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section guide-grid">
    {guides.map((guide) => (
      <article class="guide-card">
        <p class="eyebrow">{watchOrderQualityEntries(guide).length} anime entries</p>
        <h2><a href={`/watch-order/${guide.slug}/`}>{guide.title}</a></h2>
        <p>{manualWatchOrderByAnimeId[guide.rootAnimeId]?.intro || guide.description}</p>
        <a class="button small" href={`/watch-order/${guide.slug}/`} data-track-event="watch_order_entry_click" data-track-label={guide.title}>Open guide</a>
      </article>
    ))}
  </section>

  <section class="section">
    <AdSlot />
  </section>
</BaseLayout>
